FLASK_ENV=production
SECRET_KEY=replace-with-random-secret
JWT_SECRET_KEY=replace-with-random-jwt-secret
# Use the Neon pooled PostgreSQL connection string here.
# Keep the password private and configure this value in Render Environment Variables.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/bookverse?sslmode=require
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800
CORS_ORIGINS=https://your-landing-domain,https://your-buyer-domain,https://your-seller-domain,https://localhost
BOOKVERSE_OWNER_EMAIL=
